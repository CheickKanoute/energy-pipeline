{
  "name": "energy-pipeline-orchestration",
  "tags": {"project": "energy-pipeline", "env": "dev"},
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "bronze_ingest",
      "spark_python_task": {"python_file": "./src/bronze/ingest_bronze.py"},
      "timeout_seconds": 3600
    },
    {
      "task_key": "silver_transform",
      "depends_on": [{"task_key": "bronze_ingest"}],
      "spark_python_task": {"python_file": "./src/silver/transform_silver.py"},
      "timeout_seconds": 3600
    },
    {
      "task_key": "gold_build",
      "depends_on": [{"task_key": "silver_transform"}],
      "spark_python_task": {"python_file": "./src/gold/build_gold.py"},
      "timeout_seconds": 1800
    },
    {
      "task_key": "data_quality_check",
      "depends_on": [{"task_key": "gold_build"}],
      "spark_python_task": {"python_file": "./tests/run_ge_checkpoint.py"},
      "timeout_seconds": 900
    },
    {
      "task_key": "train_forecast",
      "depends_on": [{"task_key": "data_quality_check"}],
      "spark_python_task": {"python_file": "./src/mlops/train_forecast.py"},
      "timeout_seconds": 3600
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 3 * * ?",
    "timezone_id": "Europe/Paris",
    "pause_status": "UNPAUSED"
  },
  "webhook_notifications": {}
}
